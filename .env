# ==============================================================================
# Signalpost Norway Company Research Agent - API Configuration
# ==============================================================================
#
# NOTE: The agent operates 100% autonomously with $0.00 spend using Norway's 
# official open government APIs (Brønnøysund & NAV) and Google News RSS.
# 
# The keys below are OPTIONAL. If you add them, the agent will automatically
# unlock advanced web discovery and Google Places business ratings.
# ==============================================================================

# 1. BRAVE SEARCH API 
# Used for missing-website discovery when a company did not register a website with Brreg.
# Free Tier: 2,000 free searches per month!
# Get key here: https://brave.com/search/api/
BRAVE_API_KEY=

# 2. GOOGLE PLACES API 
# Used for fetching verified Google Maps place IDs, ratings, and review counts.
# Get key here: https://console.cloud.google.com/ (Enable "Places API")
GOOGLE_PLACES_API_KEY=

# 3. SERPER / GOOGLE SEARCH API 
# Fast Google search API alternative ($1 per 1,000 searches)
# Get key here: https://serper.dev
SERPER_API_KEY=

# 4. TAVILY SEARCH API 
# AI-optimized research search API
# Get key here: https://tavily.com
TAVILY_API_KEY=
