# ==============================================================================
# Signalpost Norway Company Research Agent - API Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR KEYS:
#   cp .env.example .env
#
# NOTE: .env is in .gitignore so your keys are NEVER committed to GitHub.
# ==============================================================================

# ==============================================================================
# 1. 100% FREE TOOLS & TOKENS (No Credit Card Required)
# ==============================================================================

# 1. Google Gemini API (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Groq Cloud API (Groq Console: https://console.groq.com/keys)
GROQ_API_KEY=

# 3. Tavily AI Search (Tavily Dashboard: https://app.tavily.com/)
TAVILY_API_KEY=

# 4. Hugging Face User Access Token (HF Tokens: https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=

# ==============================================================================
# 2. PAID COMMERCIAL SERVICES (Credit Card / Billing Account Required)
# ==============================================================================

# Brave Search API (https://brave.com/search/api/)
BRAVE_API_KEY=

# Mistral AI API (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Google Places API (Google Cloud Console)
GOOGLE_PLACES_API_KEY=

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=

# Perplexity AI API (https://www.perplexity.ai/)
PERPLEXITY_API_KEY=

# Cohere API (https://cohere.com/)
COHERE_API_KEY=

# DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Optional alternative search APIs
SERPER_API_KEY=

# ==============================================================================
# 3. ZERO-KEY BUILT-IN ENGINES (100% Free Always Active, No Keys Needed)
# ==============================================================================
# - Local NorBERT Neural Legal/Financial Sentiment Arbiter
# - Brønnøysund Enhetsregisteret, Regnskapsregisteret, Roller & Kunngjøringer APIs
# - NAV Arbeidsplassen Official Employment API
# - Gule Sider / Eniro Official Business Directory
# - Google News RSS Norwegian Feed
